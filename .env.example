# wda-api — staging/production configuration.
# Real values live in the deployment platform's secret store, never in the repo.
# Copy to .env for LOCAL development only (.env is git-ignored).

NODE_ENV=staging
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Injected at deploy time. The server refuses to start without it.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/wda
DB_POOL_MAX=10
# TLS is 'prefer' by default; set to 'disable' ONLY for a local database.
# DB_SSL=disable

# Set by CI from the commit being deployed; appears in /health and every log line.
BUILD_SHA=dev
