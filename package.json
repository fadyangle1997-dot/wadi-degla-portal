{
  "name": "wadi-degla-operations-academy",
  "private": true,
  "version": "7.28.0",
  "type": "module",
  "description": "Wadi Degla Operations Academy — enterprise training platform. Content-as-data, isolated business-rules engine, feature-based architecture.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:migrate": "tsx -e \"import('./server/db/client').then(async m => { const sql = await m.connect(); const { migrate } = await import('./server/db/migrate'); console.log(await migrate(sql)); await sql.end(); })\"",
    "test:server": "vitest run server",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.mjs 100",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "fastify": "^5.12.5",
    "lucide-react": "^0.383.0",
    "motion": "^11.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
