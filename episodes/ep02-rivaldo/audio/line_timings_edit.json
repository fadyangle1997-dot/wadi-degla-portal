  }
 ],
 "lines": [
  {
   "line": 0,
   "text": "في نفس اليوم اللي اتعلن فيه أفضل لاعب في أوروبا…",
   "start": 0.0,
   "end": 2.9
  },
  {
   "line": 1,
   "text": "علاقته بمدرب برشلونة انهارت.",
   "start": 3.34,
   "end": 5.29
  },
  {
   "line": 2,
   "text": "وأفضل لاعب في العالم وقتها…",
   "start": 5.78,
   "end": 7.67
  },
  {
   "line": 3,
   "text": "لقى نفسه على الدكة.",
   "start": 8.14,
   "end": 9.19
  },
  {
   "line": 4,
   "text": "لكن صدقني…",
   "start": 10.18,
   "end": 10.9
  },
  {
   "line": 5,
   "text": "دي مكانتش أصعب حاجة حصلتله.",
   "start": 11.39,
   "end": 13.34
  },
  {
   "line": 6,
   "text": "لأن قبل برشلونة…",
   "start": 13.82,
   "end": 15.68
  },
  {
   "line": 7,
   "text": "وقبل الكرة الذهبية…",
   "start": 15.78,
   "end": 16.51
  },
  {
   "line": 8,
   "text": "الولد ده عاش طفولة من أفقر ما تتخيل.",
   "start": 16.93,
   "end": 19.64
  },
  {
   "line": 9,
   "text": "جسمه كان ضعيف بسبب سوء التغذية،",
   "start": 20.24,
   "end": 22.15
  },
  {
   "line": 10,
   "text": "وخسر عدد من أسنانه وهو لسه صغير.",
   "start": 22.63,
   "end": 24.94
  },
  {
   "line": 11,
   "text": "وكان بيمشي مسافات طويلة عشان يوصل للتمرين…",
   "start": 25.47,
   "end": 28.09
  },
  {
   "line": 12,
   "text": "لأن ببساطة،",
   "start": 28.63,
   "end": 29.42
  },
  {
   "line": 13,
   "text": "مكانش معاه فلوس للمواصلات.",
   "start": 29.88,
   "end": 31.51
  },
  {
   "line": 14,
   "text": "الولد ده كان اسمه…",
   "start": 32.13,
   "end": 33.26
  },
  {
   "line": 15,
   "text": "ريفالدو فيتور بوربا فيريرا.",
   "start": 33.66,
   "end": 35.5
  },
  {
   "line": 16,
   "text": "اتولد سنة 1972 في ريسيفي،",
   "start": 36.05,
   "end": 39.19
  },
  {
   "line": 17,
   "text": "شمال شرق البرازيل،",
   "start": 39.45,
   "end": 40.65
  },
  {
   "line": 18,
   "text": "وسط عيلة فقيرة جدًا.",
   "start": 41.09,
   "end": 42.64
  },
  {
   "line": 19,
   "text": "بس كان فيه شخص واحد مؤمن إن ابنه ممكن يبقى لاعب كبير…",
   "start": 43.27,
   "end": 46.86
  },
  {
   "line": 20,
   "text": "أبوه، روميلدو.",
   "start": 47.38,
   "end": 48.62
  },
  {
   "line": 21,
   "text": "كان بيشجعه،",
   "start": 49.16,
   "end": 49.97
  },
  {
   "line": 22,
   "text": "وبيتابعه،",
   "start": 50.25,
   "end": 50.92
  },
  {
   "line": 23,
   "text": "وبيحلم معاه.",
   "start": 51.22,
   "end": 52.12
  },
  {
   "line": 24,
   "text": "لكن سنة 1989…",
   "start": 52.67,
   "end": 54.88
  },
  {
   "line": 25,
   "text": "حصلت الصدمة.",
   "start": 55.32,
   "end": 56.14
  },
  {
   "line": 26,
   "text": "والد ريفالدو مات في حادث.",
   "start": 57.34,
   "end": 59.0
  },
  {
   "line": 27,
   "text": "وريفالدو وقتها قرر يسيب الكورة.",
   "start": 59.5,
   "end": 61.53
  },
  {
   "line": 28,
   "text": "الحلم بالنسباله انتهى.",
   "start": 62.12,
   "end": 63.51
  },
  {
   "line": 29,
   "text": "لكن أمه رفضت.",
   "start": 64.06,
   "end": 65.15
  },
  {
   "line": 30,
   "text": "قالتله يكمل…",
   "start": 65.53,
   "end": 66.29
  },
  {
   "line": 31,
   "text": "لأن ده كان الحلم اللي أبوه مؤمن بيه.",
   "start": 66.84,
   "end": 68.96
  },
  {
   "line": 32,
   "text": "وريفالدو كمل.",
   "start": 69.52,
   "end": 70.33
  },
  {
   "line": 33,
   "text": "بدأ مع سانتا كروز،",
   "start": 70.89,
   "end": 72.05
  },
  {
   "line": 34,
   "text": "وبعدها موجي ميريم،",
   "start": 72.33,
   "end": 73.56
  },
  {
   "line": 35,
   "text": "ثم كورينثيانز،",
   "start": 73.89,
   "end": 74.83
  },
  {
   "line": 36,
   "text": "وبالميراس…",
   "start": 75.07,
   "end": 75.78
  },
  {
   "line": 37,
   "text": "لحد ما أوروبا بدأت تاخد بالها منه.",
   "start": 76.2,
   "end": 78.4
  },
  {
   "line": 38,
   "text": "سنة 1996…",
   "start": 79.0,
   "end": 80.91
  },
  {
   "line": 39,
   "text": "ريفالدو وصل إسبانيا من بوابة ديبورتيفو لاكورونيا.",
   "start": 81.3,
   "end": 84.34
  },
  {
   "line": 40,
   "text": "وموسم واحد بس…",
   "start": 84.89,
   "end": 86.15
  },
  {
   "line": 41,
   "text": "كان كفاية عشان برشلونة يقرر إنه عايزه.",
   "start": 86.48,
   "end": 88.85
  },
  {
   "line": 42,
   "text": "صيف 1997…",
   "start": 89.44,
   "end": 91.35
  },
  {
   "line": 43,
   "text": "برشلونة كان لسه خسر رونالدو نازاريو،",
   "start": 91.73,
   "end": 93.92
  },
  {
   "line": 44,
   "text": "اللي انتقل لإنتر ميلان.",
   "start": 94.22,
   "end": 95.53
  },
  {
   "line": 45,
   "text": "والنادي كان محتاج نجم برازيلي جديد.",
   "start": 96.1,
   "end": 98.4
  },
  {
   "line": 46,
   "text": "والاختيار وقع على ريفالدو.",
   "start": 98.84,
   "end": 100.8
  },
  {
   "line": 47,
   "text": "ومن هنا…",
   "start": 101.39,
   "end": 101.91
  },
  {
   "line": 48,
   "text": "بدأت أهم مرحلة في حكايته.",
   "start": 102.35,
   "end": 104.34
  },
  {
   "line": 49,
   "text": "في أول موسمين مع برشلونة…",
   "start": 109.94,
   "end": 111.49
  },
  {
   "line": 50,
   "text": "ريفالدو كسب الدوري الإسباني مرتين،",
   "start": 111.86,
   "end": 114.04
  },
  {
   "line": 51,
   "text": "وكأس الملك مرة.",
   "start": 114.26,
   "end": 115.37
  },
  {
   "line": 52,
   "text": "لكن اللي حصل سنة 1999…",
   "start": 115.91,
   "end": 118.77
  },
  {
   "line": 53,
   "text": "حطه رسميًا على قمة العالم.",
   "start": 119.16,
   "end": 121.2
  },
  {
   "line": 54,
   "text": "21 ديسمبر 1999.",
   "start": 121.83,
   "end": 124.91
  },
  {
   "line": 55,
   "text": "إعلان الفائز بالكرة الذهبية.",
   "start": 125.45,
   "end": 127.31
  },
  {
   "line": 56,
   "text": "ديفيد بيكهام كان جاي من موسم تاريخي،",
   "start": 127.91,
   "end": 130.22
  },
  {
   "line": 57,
   "text": "حقق فيه الثلاثية مع مانشستر يونايتد.",
   "start": 130.65,
   "end": 132.99
  },
  {
   "line": 58,
   "text": "لكن النتيجة كانت…",
   "start": 133.48,
   "end": 134.72
  },
  {
   "line": 59,
   "text": "بيكهام: 154 نقطة.",
   "start": 136.0,
   "end": 138.55
  },
  {
   "line": 60,
   "text": "ريفالدو: 219.",
   "start": 139.05,
   "end": 141.38
  },
  {
   "line": 61,
   "text": "ريفالدو يفوز بالكرة الذهبية.",
   "start": 141.53,
   "end": 144.04
  },
  {
   "line": 62,
   "text": "وكمان يفوز بجائزة الفيفا لأفضل لاعب في العالم لسنة 1999.",
   "start": 144.53,
   "end": 150.19
  },
  {
   "line": 63,
   "text": "الطفل اللي كان بيعاني عشان يوصل التمرين…",
   "start": 150.77,
   "end": 153.3
  },
  {
   "line": 64,
   "text": "بقى أفضل لاعب في العالم.",
   "start": 153.71,
   "end": 155.36
  },
  {
   "line": 65,
   "text": "المفروض دي تبقى أسعد فترة في حياته…",
   "start": 156.02,
   "end": 158.21
  },
  {
   "line": 66,
   "text": "صح؟",
   "start": 158.49,
   "end": 158.8
  },
  {
   "line": 67,
   "text": "لأ.",
   "start": 160.16,
   "end": 160.48
  },
  {
   "line": 68,
   "text": "لأن مع الكرة الذهبية…",
   "start": 161.49,
   "end": 162.82
  },
  {
   "line": 69,
   "text": "بدأت واحدة من أغرب أزمات ريفالدو مع برشلونة.",
   "start": 163.16,
   "end": 166.23
  },
  {
   "line": 70,
   "text": "لويس فان خال كان عايزه يلعب على الجناح الشمال.",
   "start": 166.82,
   "end": 169.31
  },
  {
   "line": 71,
   "text": "وريفالدو كان شايف إن أفضل مكان ليه هو العمق…",
   "start": 169.84,
   "end": 172.88
  },
  {
   "line": 72,
   "text": "خلف المهاجمين.",
   "start": 172.99,
   "end": 174.14
  },
  {
   "line": 73,
   "text": "الخلاف كبر…",
   "start": 174.71,
   "end": 175.53
  },
  {
   "line": 74,
   "text": "وريفالدو أعلن إنه مش عايز يكمل في مركز الجناح.",
   "start": 175.99,
   "end": 179.08
  },
  {
   "line": 75,
   "text": "فان خال رد بطريقته.",
   "start": 179.59,
   "end": 180.86
  },
  {
   "line": 76,
   "text": "استبعد أفضل لاعب في العالم من الفريق.",
   "start": 181.4,
   "end": 184.02
  },
  {
   "line": 77,
   "text": "الكرة الذهبية في إيده…",
   "start": 184.73,
   "end": 185.99
  },
  {
   "line": 78,
   "text": "ومكانه مش مضمون في التشكيل.",
   "start": 186.38,
   "end": 188.19
  },
  {
   "line": 79,
   "text": "لكن لو عايز تعرف ريفالدو كان لاعب عامل إزاي…",
   "start": 188.71,
   "end": 191.27
  },
  {
   "line": 80,
   "text": "فأنت محتاج تشوف ليلة واحدة بس.",
   "start": 194.75,
   "end": 196.88
  },
  {
   "line": 81,
   "text": "17 يونيو 2001.",
   "start": 197.44,
   "end": 199.43
  },
  {
   "line": 82,
   "text": "آخر جولة في الدوري الإسباني.",
   "start": 199.86,
   "end": 201.52
  },
  {
   "line": 83,
   "text": "برشلونة ضد فالنسيا…",
   "start": 202.0,
   "end": 203.72
  },
  {
   "line": 84,
   "text": "في الكامب نو.",
   "start": 204.01,
   "end": 204.68
  },
  {
   "line": 85,
   "text": "والحسبة بسيطة جدًا:",
   "start": 205.23,
   "end": 206.35
  },
  {
   "line": 86,
   "text": "برشلونة لازم يكسب…",
   "start": 206.87,
   "end": 208.22
  },
  {
   "line": 87,
   "text": "عشان يتأهل لدوري أبطال أوروبا.",
   "start": 208.31,
   "end": 210.11
  },
  {
   "line": 88,
   "text": "وريفالدو قرر يعمل واحدة من أعظم مبارياته بقميص برشلونة.",
   "start": 210.6,
   "end": 214.7,
   "checked": "manual"
  },
  {
   "line": 89,
   "text": "الجول الأول…",
   "start": 214.98,
   "end": 215.99,
   "checked": "manual"
  },
  {
   "line": 90,
   "text": "ضربة حرة مباشرة.",
   "start": 216.18,
   "end": 217.4,
   "checked": "manual"
  },
  {
   "line": 91,
   "text": "1-0.",
   "start": 217.76,
   "end": 218.44,
   "checked": "manual"
  },
  {
   "line": 92,
   "text": "فالنسيا يتعادل.",
   "start": 218.71,
   "end": 219.7,
   "checked": "manual"
  },
  {
   "line": 93,
   "text": "ريفالدو ياخد الكرة من بعيد…",
   "start": 220.21,
   "end": 221.87,
   "checked": "manual"
  },
  {
   "line": 94,
   "text": "ويسدد.",
   "start": 222.07,
   "end": 222.74,
   "checked": "manual"
  },
  {
   "line": 95,
   "text": "جول تاني.",
   "start": 223.03,
   "end": 223.73,
   "checked": "manual"
  },
  {
   "line": 96,
   "text": "2-1.",
   "start": 224.0,
   "end": 224.75,
   "checked": "manual"
  },
  {
   "line": 97,
   "text": "فالنسيا يتعادل من جديد.",
   "start": 225.09,
   "end": 226.53,
   "checked": "manual"
  },
  {
   "line": 98,
   "text": "2-2.",
   "start": 227.05,
   "end": 227.94,
   "checked": "manual"
  },
  {
   "line": 99,
   "text": "والوقت بيخلص.",
   "start": 228.17,
   "end": 229.24,
   "checked": "manual"
  },
  {
   "line": 100,
   "text": "بالنتيجة دي…",
   "start": 229.61,
   "end": 230.32
  },
  {
   "line": 101,
   "text": "برشلونة خارج دوري الأبطال.",
   "start": 230.64,
   "end": 232.56
  },
  {
   "line": 102,
   "text": "الدقيقة 87.",
   "start": 232.98,
   "end": 234.16
  },
  {
   "line": 103,
   "text": "فرانك دي بور يرسل كرة ناحية منطقة الجزاء.",
   "start": 234.42,
   "end": 236.85,
   "checked": "manual"
  },
  {
   "line": 104,
   "text": "ريفالدو يستقبلها بصدره…",
   "start": 237.19,
   "end": 238.56,
   "checked": "manual"
  },
  {
   "line": 105,
   "text": "والكرة لسه في الهوا…",
   "start": 238.72,
   "end": 239.89,
   "checked": "manual"
  },
  {
   "line": 106,
   "text": "يرمي جسمه للخلف…",
   "start": 240.11,
   "end": 241.35,
   "checked": "manual"
  },
  {
   "line": 107,
   "text": "مقصية.",
   "start": 242.45,
   "end": 243.17,
   "checked": "manual"
  },
  {
   "line": 108,
   "text": "جــــــــول.",
   "start": 243.37,
   "end": 244.31,
   "checked": "manual"
  },
  {
   "line": 109,
   "text": "3-2.",
   "start": 246.07,
   "end": 246.93,
   "checked": "manual"
  },
  {
   "line": 110,
   "text": "هاتريك لريـفالدو.",
   "start": 247.15,
   "end": 248.16,
   "checked": "manual"
  },
  {
   "line": 111,
   "text": "وبرشلونة إلى دوري أبطال أوروبا.",
   "start": 248.36,
   "end": 250.71,
   "checked": "manual"
  },
  {
   "line": 112,
   "text": "الكامب نو انفجر.",
   "start": 251.06,
   "end": 252.59
  },
  {
   "line": 113,
   "text": "وفي لحظة واحدة…",
   "start": 252.87,
   "end": 253.82
  },
  {
   "line": 114,
   "text": "ريفالدو أنقذ موسم برشلونة…",
   "start": 254.13,
   "end": 256.15
  },
  {
   "line": 115,
   "text": "بواحد من أشهر الأهداف في تاريخ النادي.",
   "start": 256.47,
   "end": 259.09
  },
  {
   "line": 116,
   "text": "لكن حكايته لسه كان ناقصها آخر مشهد.",
   "start": 259.62,
   "end": 262.94
  },
  {
   "line": 117,
   "text": "صيف 2002.",
   "start": 263.51,
   "end": 264.65
  },
  {
   "line": 118,
   "text": "ريفالدو واقف مع منتخب البرازيل في نهائي كأس العالم.",
   "start": 264.96,
   "end": 268.03
  },
  {
   "line": 119,
   "text": "البرازيل ضد ألمانيا.",
   "start": 268.47,
   "end": 270.02
  },
  {
   "line": 120,
   "text": "والبرازيل تكسب 2-0…",
   "start": 270.43,
   "end": 272.01
  },
  {
   "line": 121,
   "text": "وريفالدو يبقى بطل عالم.",
   "start": 272.32,
   "end": 274.15
  },
  {
   "line": 122,
   "text": "بس لما رجع من كأس العالم…",
   "start": 274.72,
   "end": 276.31
  },
  {
   "line": 123,
   "text": "لقى فان خال راجع يدرب برشلونة من تاني.",
   "start": 276.7,
   "end": 279.17
  },
  {
   "line": 124,
   "text": "وريفالدو قرر يرحل.",
   "start": 279.64,
   "end": 281.31
  },
  {
   "line": 125,
   "text": "من طفل عاش الفقر وسوء التغذية…",
   "start": 281.98,
   "end": 284.28
  },
  {
   "line": 126,
   "text": "وفقد أبوه وهو لسه بيحاول يبدأ مشواره…",
   "start": 284.64,
   "end": 287.36
  },
  {
   "line": 127,
   "text": "إلى لاعب حمل الكرة الذهبية…",
   "start": 287.79,
   "end": 289.81
  },
  {
   "line": 128,
   "text": "وسجل هدفًا مستحيلًا أنقذ به برشلونة في واحدة من أهم لياليه…",
   "start": 290.16,
   "end": 295.54
  },
  {
   "line": 129,
   "text": "وبعدها رفع كأس العالم بالرقم 10 مع البرازيل.",
   "start": 295.99,
   "end": 300.14
  },
  {
   "line": 130,
   "text": "دي كانت حكاية…",
