  }
 ],
 "lines": [
  {
   "line": 0,
   "text": "في نفس اليوم اللي اتعلن فيه أفضل لاعب في أوروبا…",
   "start": 0.0,
   "end": 2.9
  },
  {
   "line": 1,
   "text": "علاقته بمدرب برشلونة انهارت.",
   "start": 3.34,
   "end": 5.29
  },
  {
   "line": 2,
   "text": "وأفضل لاعب في العالم وقتها…",
   "start": 5.78,
   "end": 7.67
  },
  {
   "line": 3,
   "text": "لقى نفسه على الدكة.",
   "start": 8.14,
   "end": 9.19
  },
  {
   "line": 4,
   "text": "لكن صدقني…",
   "start": 10.18,
   "end": 10.9
  },
  {
   "line": 5,
   "text": "دي مكانتش أصعب حاجة حصلتله.",
   "start": 11.39,
   "end": 13.34
  },
  {
   "line": 6,
   "text": "لأن قبل برشلونة…",
   "start": 13.82,
   "end": 15.68
  },
  {
   "line": 7,
   "text": "وقبل الكرة الذهبية…",
   "start": 15.78,
   "end": 16.51
  },
  {
   "line": 8,
   "text": "الولد ده عاش طفولة من أفقر ما تتخيل.",
   "start": 16.93,
   "end": 19.64
  },
  {
   "line": 9,
   "text": "جسمه كان ضعيف بسبب سوء التغذية،",
   "start": 20.24,
   "end": 22.15
  },
  {
   "line": 10,
   "text": "وخسر عدد من أسنانه وهو لسه صغير.",
   "start": 22.63,
   "end": 24.94
  },
  {
   "line": 11,
   "text": "وكان بيمشي مسافات طويلة عشان يوصل للتمرين…",
   "start": 25.47,
   "end": 28.09
  },
  {
   "line": 12,
   "text": "لأن ببساطة،",
   "start": 28.63,
   "end": 29.42
  },
  {
   "line": 13,
   "text": "مكانش معاه فلوس للمواصلات.",
   "start": 29.88,
   "end": 31.51
  },
  {
   "line": 14,
   "text": "الولد ده كان اسمه…",
   "start": 32.13,
   "end": 33.26
  },
  {
   "line": 15,
   "text": "ريفالدو فيتور بوربا فيريرا.",
   "start": 33.66,
   "end": 35.5
  },
  {
   "line": 16,
   "text": "اتولد سنة 1972 في ريسيفي،",
   "start": 36.05,
   "end": 39.19
  },
  {
   "line": 17,
   "text": "شمال شرق البرازيل،",
   "start": 39.45,
   "end": 40.65
  },
  {
   "line": 18,
   "text": "وسط عيلة فقيرة جدًا.",
   "start": 41.09,
   "end": 42.64
  },
  {
   "line": 19,
   "text": "بس كان فيه شخص واحد مؤمن إن ابنه ممكن يبقى لاعب كبير…",
   "start": 43.27,
   "end": 46.86
  },
  {
   "line": 20,
   "text": "أبوه، روميلدو.",
   "start": 47.38,
   "end": 48.62
  },
  {
   "line": 21,
   "text": "كان بيشجعه،",
   "start": 49.16,
   "end": 49.97
  },
  {
   "line": 22,
   "text": "وبيتابعه،",
   "start": 50.25,
   "end": 50.92
  },
  {
   "line": 23,
   "text": "وبيحلم معاه.",
   "start": 51.22,
   "end": 52.12
  },
  {
   "line": 24,
   "text": "لكن سنة 1989…",
   "start": 52.67,
   "end": 54.88
  },
  {
   "line": 25,
   "text": "حصلت الصدمة.",
   "start": 55.32,
   "end": 56.14
  },
  {
   "line": 26,
   "text": "والد ريفالدو مات في حادث.",
   "start": 57.34,
   "end": 59.0
  },
  {
   "line": 27,
   "text": "وريفالدو وقتها قرر يسيب الكورة.",
   "start": 59.5,
   "end": 61.53
  },
  {
   "line": 28,
   "text": "الحلم بالنسباله انتهى.",
   "start": 62.12,
   "end": 63.51
  },
  {
   "line": 29,
   "text": "لكن أمه رفضت.",
   "start": 64.06,
   "end": 65.15
  },
  {
   "line": 30,
   "text": "قالتله يكمل…",
   "start": 65.53,
   "end": 66.29
  },
  {
   "line": 31,
   "text": "لأن ده كان الحلم اللي أبوه مؤمن بيه.",
   "start": 66.84,
   "end": 68.96
  },
  {
   "line": 32,
   "text": "وريفالدو كمل.",
   "start": 69.52,
   "end": 70.33
  },
  {
   "line": 33,
   "text": "بدأ مع سانتا كروز،",
   "start": 70.89,
   "end": 72.05
  },
  {
   "line": 34,
   "text": "وبعدها موجي ميريم،",
   "start": 72.33,
   "end": 73.56
  },
  {
   "line": 35,
   "text": "ثم كورينثيانز،",
   "start": 73.89,
   "end": 74.83
  },
  {
   "line": 36,
   "text": "وبالميراس…",
   "start": 75.07,
   "end": 75.78
  },
  {
   "line": 37,
   "text": "لحد ما أوروبا بدأت تاخد بالها منه.",
   "start": 76.2,
   "end": 78.4
  },
  {
   "line": 38,
   "text": "سنة 1996…",
   "start": 79.0,
   "end": 80.91
  },
  {
   "line": 39,
   "text": "ريفالدو وصل إسبانيا من بوابة ديبورتيفو لاكورونيا.",
   "start": 81.3,
   "end": 84.34
  },
  {
   "line": 40,
   "text": "وموسم واحد بس…",
   "start": 84.89,
   "end": 86.15
  },
  {
   "line": 41,
   "text": "كان كفاية عشان برشلونة يقرر إنه عايزه.",
   "start": 86.48,
   "end": 88.85
  },
  {
   "line": 42,
   "text": "صيف 1997…",
   "start": 89.44,
   "end": 91.35
  },
  {
   "line": 43,
   "text": "برشلونة كان لسه خسر رونالدو نازاريو،",
   "start": 91.73,
   "end": 93.92
  },
  {
   "line": 44,
   "text": "اللي انتقل لإنتر ميلان.",
   "start": 94.22,
   "end": 95.53
  },
  {
   "line": 45,
   "text": "والنادي كان محتاج نجم برازيلي جديد.",
   "start": 96.1,
   "end": 98.4
  },
  {
   "line": 46,
   "text": "والاختيار وقع على ريفالدو.",
   "start": 98.84,
   "end": 100.8
  },
  {
   "line": 47,
   "text": "ومن هنا…",
   "start": 101.39,
   "end": 101.91
  },
  {
   "line": 48,
   "text": "بدأت أهم مرحلة في حكايته.",
   "start": 102.35,
   "end": 104.34
  },
  {
   "line": 49,
   "text": "في أول موسمين مع برشلونة…",
   "start": 104.94,
   "end": 106.49
  },
  {
   "line": 50,
   "text": "ريفالدو كسب الدوري الإسباني مرتين،",
   "start": 106.86,
   "end": 109.04
  },
  {
   "line": 51,
   "text": "وكأس الملك مرة.",
   "start": 109.26,
   "end": 110.37
  },
  {
   "line": 52,
   "text": "لكن اللي حصل سنة 1999…",
   "start": 110.91,
   "end": 113.77
  },
  {
   "line": 53,
   "text": "حطه رسميًا على قمة العالم.",
   "start": 114.16,
   "end": 116.2
  },
  {
   "line": 54,
   "text": "21 ديسمبر 1999.",
   "start": 116.83,
   "end": 119.91
  },
  {
   "line": 55,
   "text": "إعلان الفائز بالكرة الذهبية.",
   "start": 120.45,
   "end": 122.31
  },
  {
   "line": 56,
   "text": "ديفيد بيكهام كان جاي من موسم تاريخي،",
   "start": 122.91,
   "end": 125.22
  },
  {
   "line": 57,
   "text": "حقق فيه الثلاثية مع مانشستر يونايتد.",
   "start": 125.65,
   "end": 127.99
  },
  {
   "line": 58,
   "text": "لكن النتيجة كانت…",
   "start": 128.48,
   "end": 129.72
  },
  {
   "line": 59,
   "text": "بيكهام: 154 نقطة.",
   "start": 131.0,
   "end": 133.55
  },
  {
   "line": 60,
   "text": "ريفالدو: 219.",
   "start": 134.05,
   "end": 136.38
  },
  {
   "line": 61,
   "text": "ريفالدو يفوز بالكرة الذهبية.",
   "start": 136.53,
   "end": 139.04
  },
  {
   "line": 62,
   "text": "وكمان يفوز بجائزة الفيفا لأفضل لاعب في العالم لسنة 1999.",
   "start": 139.53,
   "end": 145.19
  },
  {
   "line": 63,
   "text": "الطفل اللي كان بيعاني عشان يوصل التمرين…",
   "start": 145.77,
   "end": 148.3
  },
  {
   "line": 64,
   "text": "بقى أفضل لاعب في العالم.",
   "start": 148.71,
   "end": 150.36
  },
  {
   "line": 65,
   "text": "المفروض دي تبقى أسعد فترة في حياته…",
   "start": 151.02,
   "end": 153.21
  },
  {
   "line": 66,
   "text": "صح؟",
   "start": 153.49,
   "end": 153.8
  },
  {
   "line": 67,
   "text": "لأ.",
   "start": 155.16,
   "end": 155.48
  },
  {
   "line": 68,
   "text": "لأن مع الكرة الذهبية…",
   "start": 156.49,
   "end": 157.82
  },
  {
   "line": 69,
   "text": "بدأت واحدة من أغرب أزمات ريفالدو مع برشلونة.",
   "start": 158.16,
   "end": 161.23
  },
  {
   "line": 70,
   "text": "لويس فان خال كان عايزه يلعب على الجناح الشمال.",
   "start": 161.82,
   "end": 164.31
  },
  {
   "line": 71,
   "text": "وريفالدو كان شايف إن أفضل مكان ليه هو العمق…",
   "start": 164.84,
   "end": 167.88
  },
  {
   "line": 72,
   "text": "خلف المهاجمين.",
   "start": 167.99,
   "end": 169.14
  },
  {
   "line": 73,
   "text": "الخلاف كبر…",
   "start": 169.71,
   "end": 170.53
  },
  {
   "line": 74,
   "text": "وريفالدو أعلن إنه مش عايز يكمل في مركز الجناح.",
   "start": 170.99,
   "end": 174.08
  },
  {
   "line": 75,
   "text": "فان خال رد بطريقته.",
   "start": 174.59,
   "end": 175.86
  },
  {
   "line": 76,
   "text": "استبعد أفضل لاعب في العالم من الفريق.",
   "start": 176.4,
   "end": 179.02
  },
  {
   "line": 77,
   "text": "الكرة الذهبية في إيده…",
   "start": 179.73,
   "end": 180.99
  },
  {
   "line": 78,
   "text": "ومكانه مش مضمون في التشكيل.",
   "start": 181.38,
   "end": 183.19
  },
  {
   "line": 79,
   "text": "لكن لو عايز تعرف ريفالدو كان لاعب عامل إزاي…",
   "start": 183.71,
   "end": 186.27
  },
  {
   "line": 80,
   "text": "فأنت محتاج تشوف ليلة واحدة بس.",
   "start": 186.75,
   "end": 188.88
  },
  {
   "line": 81,
   "text": "17 يونيو 2001.",
   "start": 189.44,
   "end": 191.43
  },
  {
   "line": 82,
   "text": "آخر جولة في الدوري الإسباني.",
   "start": 191.86,
   "end": 193.52
  },
  {
   "line": 83,
   "text": "برشلونة ضد فالنسيا…",
   "start": 194.0,
   "end": 195.72
  },
  {
   "line": 84,
   "text": "في الكامب نو.",
   "start": 196.01,
   "end": 196.68
  },
  {
   "line": 85,
   "text": "والحسبة بسيطة جدًا:",
   "start": 197.23,
   "end": 198.35
  },
  {
   "line": 86,
   "text": "برشلونة لازم يكسب…",
   "start": 198.87,
   "end": 200.22
  },
  {
   "line": 87,
   "text": "عشان يتأهل لدوري أبطال أوروبا.",
   "start": 200.31,
   "end": 202.11
  },
  {
   "line": 88,
   "text": "وريفالدو قرر يعمل واحدة من أعظم مبارياته بقميص برشلونة.",
   "start": 202.6,
   "end": 206.7,
   "checked": "manual"
  },
  {
   "line": 89,
   "text": "الجول الأول…",
   "start": 206.98,
   "end": 207.99,
   "checked": "manual"
  },
  {
   "line": 90,
   "text": "ضربة حرة مباشرة.",
   "start": 208.18,
   "end": 209.4,
   "checked": "manual"
  },
  {
   "line": 91,
   "text": "1-0.",
   "start": 209.76,
   "end": 210.44,
   "checked": "manual"
  },
  {
   "line": 92,
   "text": "فالنسيا يتعادل.",
   "start": 210.71,
   "end": 211.7,
   "checked": "manual"
  },
  {
   "line": 93,
   "text": "ريفالدو ياخد الكرة من بعيد…",
   "start": 212.21,
   "end": 213.87,
   "checked": "manual"
  },
  {
   "line": 94,
   "text": "ويسدد.",
   "start": 214.07,
   "end": 214.74,
   "checked": "manual"
  },
  {
   "line": 95,
   "text": "جول تاني.",
   "start": 215.03,
   "end": 215.73,
   "checked": "manual"
  },
  {
   "line": 96,
   "text": "2-1.",
   "start": 216.0,
   "end": 216.75,
   "checked": "manual"
  },
  {
   "line": 97,
   "text": "فالنسيا يتعادل من جديد.",
   "start": 217.09,
   "end": 218.53,
   "checked": "manual"
  },
  {
   "line": 98,
   "text": "2-2.",
   "start": 219.05,
   "end": 219.94,
   "checked": "manual"
  },
  {
   "line": 99,
   "text": "والوقت بيخلص.",
   "start": 220.17,
   "end": 221.24,
   "checked": "manual"
  },
  {
   "line": 100,
   "text": "بالنتيجة دي…",
   "start": 221.61,
   "end": 222.32
  },
  {
   "line": 101,
   "text": "برشلونة خارج دوري الأبطال.",
   "start": 222.64,
   "end": 224.56
  },
  {
   "line": 102,
   "text": "الدقيقة 87.",
   "start": 224.98,
   "end": 226.16
  },
  {
   "line": 103,
   "text": "فرانك دي بور يرسل كرة ناحية منطقة الجزاء.",
   "start": 226.42,
   "end": 228.85,
   "checked": "manual"
  },
  {
   "line": 104,
   "text": "ريفالدو يستقبلها بصدره…",
   "start": 229.19,
   "end": 230.56,
   "checked": "manual"
  },
  {
   "line": 105,
   "text": "والكرة لسه في الهوا…",
   "start": 230.72,
   "end": 231.89,
   "checked": "manual"
  },
  {
   "line": 106,
   "text": "يرمي جسمه للخلف…",
   "start": 232.11,
   "end": 233.35,
   "checked": "manual"
  },
  {
   "line": 107,
   "text": "مقصية.",
   "start": 234.45,
   "end": 235.17,
   "checked": "manual"
  },
  {
   "line": 108,
   "text": "جــــــــول.",
   "start": 235.37,
   "end": 236.31,
   "checked": "manual"
  },
  {
   "line": 109,
   "text": "3-2.",
   "start": 238.07,
   "end": 238.93,
   "checked": "manual"
  },
  {
   "line": 110,
   "text": "هاتريك لريـفالدو.",
   "start": 239.15,
   "end": 240.16,
   "checked": "manual"
  },
  {
   "line": 111,
   "text": "وبرشلونة إلى دوري أبطال أوروبا.",
   "start": 240.36,
   "end": 242.71,
   "checked": "manual"
  },
  {
   "line": 112,
   "text": "الكامب نو انفجر.",
   "start": 243.06,
   "end": 244.59
  },
  {
   "line": 113,
   "text": "وفي لحظة واحدة…",
   "start": 244.87,
   "end": 245.82
  },
  {
   "line": 114,
   "text": "ريفالدو أنقذ موسم برشلونة…",
   "start": 246.13,
   "end": 248.15
  },
  {
   "line": 115,
   "text": "بواحد من أشهر الأهداف في تاريخ النادي.",
   "start": 248.47,
   "end": 251.09
  },
  {
   "line": 116,
   "text": "لكن حكايته لسه كان ناقصها آخر مشهد.",
   "start": 251.62,
   "end": 254.94
  },
  {
   "line": 117,
   "text": "صيف 2002.",
   "start": 255.51,
   "end": 256.65
  },
  {
   "line": 118,
   "text": "ريفالدو واقف مع منتخب البرازيل في نهائي كأس العالم.",
   "start": 256.96,
   "end": 260.03
  },
  {
   "line": 119,
   "text": "البرازيل ضد ألمانيا.",
   "start": 260.47,
   "end": 262.02
  },
  {
   "line": 120,
   "text": "والبرازيل تكسب 2-0…",
   "start": 262.43,
   "end": 264.01
  },
  {
   "line": 121,
   "text": "وريفالدو يبقى بطل عالم.",
   "start": 264.32,
   "end": 266.15
  },
  {
   "line": 122,
   "text": "بس لما رجع من كأس العالم…",
   "start": 266.72,
   "end": 268.31
  },
  {
   "line": 123,
   "text": "لقى فان خال راجع يدرب برشلونة من تاني.",
   "start": 268.7,
   "end": 271.17
  },
  {
   "line": 124,
   "text": "وريفالدو قرر يرحل.",
   "start": 271.64,
   "end": 273.31
  },
  {
   "line": 125,
   "text": "من طفل عاش الفقر وسوء التغذية…",
   "start": 273.98,
   "end": 276.28
  },
  {
   "line": 126,
   "text": "وفقد أبوه وهو لسه بيحاول يبدأ مشواره…",
   "start": 276.64,
   "end": 279.36
  },
  {
   "line": 127,
   "text": "إلى لاعب حمل الكرة الذهبية…",
   "start": 279.79,
   "end": 281.81
  },
  {
   "line": 128,
   "text": "وسجل هدفًا مستحيلًا أنقذ به برشلونة في واحدة من أهم لياليه…",
   "start": 282.16,
   "end": 287.54
  },
  {
   "line": 129,
   "text": "وبعدها رفع كأس العالم بالرقم 10 مع البرازيل.",
   "start": 287.99,
   "end": 292.14
  },
  {
   "line": 130,
   "text": "دي كانت حكاية…",
   "start": 292.83,
   "end": 294.27
  },
  {
   "line": 131,
   "text": "ريفالدو.",
   "start": 295.15,
   "end": 295.87
  },
  {
   "line": 132,
   "text": "واحد من أعظم البرازيليين اللي لبسوا قميص برشلونة.",
   "start": 296.32,
   "end": 299.95
  },
  {
   "line": 133,
   "text": "وفي الحلقة الجاية…",
   "start": 300.51,
   "end": 301.36
  },
  {
   "line": 134,
   "text": "هنتكلم عن برازيلي تاني وصل برشلونة بعد ما ريفالدو مشي بسنة.",
   "start": 301.68,
   "end": 305.55
  },
  {
   "line": 135,
   "text": "لكن المرة دي…",
   "start": 305.97,
   "end": 306.83
  },
  {
   "line": 136,
   "text": "الابتسامة كانت جزء من اللعبة.",
   "start": 307.2,
   "end": 309.48
  },
  {
   "line": 137,
   "text": "رونالدينيو.",
   "start": 310.0,
   "end": 310.97
  }
 ]
}