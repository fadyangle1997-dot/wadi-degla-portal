[
 {
  "line": 0,
  "text": "في نفس اليوم اللي اتعلن فيه أفضل لاعب في أوروبا…",
  "start": 0.0,
  "end": 2.9
 },
 {
  "line": 1,
  "text": "علاقته بمدرب برشلونة انهارت.",
  "start": 3.34,
  "end": 5.29
 },
 {
  "line": 2,
  "text": "وأفضل لاعب في العالم وقتها…",
  "start": 5.78,
  "end": 7.67
 },
 {
  "line": 3,
  "text": "لقى نفسه على الدكة.",
  "start": 8.14,
  "end": 9.19
 },
 {
  "line": 4,
  "text": "لكن صدقني…",
  "start": 9.78,
  "end": 10.5
 },
 {
  "line": 5,
  "text": "دي مكانتش أصعب حاجة حصلتله.",
  "start": 10.99,
  "end": 12.94
 },
 {
  "line": 6,
  "text": "لأن قبل برشلونة…",
  "start": 13.42,
  "end": 15.28
 },
 {
  "line": 7,
  "text": "وقبل الكرة الذهبية…",
  "start": 15.38,
  "end": 16.11
 },
 {
  "line": 8,
  "text": "الولد ده عاش طفولة من أفقر ما تتخيل.",
  "start": 16.53,
  "end": 19.24
 },
 {
  "line": 9,
  "text": "جسمه كان ضعيف بسبب سوء التغذية،",
  "start": 19.84,
  "end": 21.75
 },
 {
  "line": 10,
  "text": "وخسر عدد من أسنانه وهو لسه صغير.",
  "start": 22.23,
  "end": 24.54
 },
 {
  "line": 11,
  "text": "وكان بيمشي مسافات طويلة عشان يوصل للتمرين…",
  "start": 25.07,
  "end": 27.69
 },
 {
  "line": 12,
  "text": "لأن ببساطة،",
  "start": 28.23,
  "end": 29.02
 },
 {
  "line": 13,
  "text": "مكانش معاه فلوس للمواصلات.",
  "start": 29.48,
  "end": 31.11
 },
 {
  "line": 14,
  "text": "الولد ده كان اسمه…",
  "start": 31.73,
  "end": 32.86
 },
 {
  "line": 15,
  "text": "ريفالدو فيتور بوربا فيريرا.",
  "start": 33.26,
  "end": 35.1
 },
 {
  "line": 16,
  "text": "اتولد سنة 1972 في ريسيفي،",
  "start": 35.65,
  "end": 38.79
 },
 {
  "line": 17,
  "text": "شمال شرق البرازيل،",
  "start": 39.05,
  "end": 40.25
 },
 {
  "line": 18,
  "text": "وسط عيلة فقيرة جدًا.",
  "start": 40.69,
  "end": 42.24
 },
 {
  "line": 19,
  "text": "بس كان فيه شخص واحد مؤمن إن ابنه ممكن يبقى لاعب كبير…",
  "start": 42.87,
  "end": 46.46
 },
 {
  "line": 20,
  "text": "أبوه، روميلدو.",
  "start": 46.98,
  "end": 48.22
 },
 {
  "line": 21,
  "text": "كان بيشجعه،",
  "start": 48.76,
  "end": 49.57
 },
 {
  "line": 22,
  "text": "وبيتابعه،",
  "start": 49.85,
  "end": 50.52
 },
 {
  "line": 23,
  "text": "وبيحلم معاه.",
  "start": 50.82,
  "end": 51.72
 },
 {
  "line": 24,
  "text": "لكن سنة 1989…",
  "start": 52.27,
  "end": 54.48
 },
 {
  "line": 25,
  "text": "حصلت الصدمة.",
  "start": 54.92,
  "end": 55.74
 },
 {
  "line": 26,
  "text": "والد ريفالدو مات في حادث.",
  "start": 56.34,
  "end": 58.0
 },
 {
  "line": 27,
  "text": "وريفالدو وقتها قرر يسيب الكورة.",
  "start": 58.5,
  "end": 60.53
 },
 {
  "line": 28,
  "text": "الحلم بالنسباله انتهى.",
  "start": 61.12,
  "end": 62.51
 },
 {
  "line": 29,
  "text": "لكن أمه رفضت.",
  "start": 63.06,
  "end": 64.15
 },
 {
  "line": 30,
  "text": "قالتله يكمل…",
  "start": 64.53,
  "end": 65.29
 },
 {
  "line": 31,
  "text": "لأن ده كان الحلم اللي أبوه مؤمن بيه.",
  "start": 65.84,
  "end": 67.96
 },
 {
  "line": 32,
  "text": "وريفالدو كمل.",
  "start": 68.52,
  "end": 69.33
 },
 {
  "line": 33,
  "text": "بدأ مع سانتا كروز،",
  "start": 69.89,
  "end": 71.05
 },
 {
  "line": 34,
  "text": "وبعدها موجي ميريم،",
  "start": 71.33,
  "end": 72.56
 },
 {
  "line": 35,
  "text": "ثم كورينثيانز،",
  "start": 72.89,
  "end": 73.83
 },
 {
  "line": 36,
  "text": "وبالميراس…",
  "start": 74.07,
  "end": 74.78
 },
 {
  "line": 37,
  "text": "لحد ما أوروبا بدأت تاخد بالها منه.",
  "start": 75.2,
  "end": 77.4
 },
 {
  "line": 38,
  "text": "سنة 1996…",
  "start": 78.0,
  "end": 79.91
 },
 {
  "line": 39,
  "text": "ريفالدو وصل إسبانيا من بوابة ديبورتيفو لاكورونيا.",
  "start": 80.3,
  "end": 83.34
 },
 {
  "line": 40,
  "text": "وموسم واحد بس…",
  "start": 83.89,
  "end": 85.15
 },
 {
  "line": 41,
  "text": "كان كفاية عشان برشلونة يقرر إنه عايزه.",
  "start": 85.48,
  "end": 87.85
 },
 {
  "line": 42,
  "text": "صيف 1997…",
  "start": 88.44,
  "end": 90.35
 },
 {
  "line": 43,
  "text": "برشلونة كان لسه خسر رونالدو نازاريو،",
  "start": 90.73,
  "end": 92.92
 },
 {
  "line": 44,
  "text": "اللي انتقل لإنتر ميلان.",
  "start": 93.22,
  "end": 94.53
 },
 {
  "line": 45,
  "text": "والنادي كان محتاج نجم برازيلي جديد.",
  "start": 95.1,
  "end": 97.4
 },
 {
  "line": 46,
  "text": "والاختيار وقع على ريفالدو.",
  "start": 97.84,
  "end": 99.8
 },
 {
  "line": 47,
  "text": "ومن هنا…",
  "start": 100.39,
  "end": 100.91
 },
 {
  "line": 48,
  "text": "بدأت أهم مرحلة في حكايته.",
  "start": 101.35,
  "end": 103.34
 },
 {
  "line": 49,
  "text": "في أول موسمين مع برشلونة…",
  "start": 103.94,
  "end": 105.49
 },
 {
  "line": 50,
  "text": "ريفالدو كسب الدوري الإسباني مرتين،",
  "start": 105.86,
  "end": 108.04
 },
 {
  "line": 51,
  "text": "وكأس الملك مرة.",
  "start": 108.26,
  "end": 109.37
 },
 {
  "line": 52,
  "text": "لكن اللي حصل سنة 1999…",
  "start": 109.91,
  "end": 112.77
 },
 {
  "line": 53,
  "text": "حطه رسميًا على قمة العالم.",
  "start": 113.16,
  "end": 115.2
 },
 {
  "line": 54,
  "text": "21 ديسمبر 1999.",
  "start": 115.83,
  "end": 118.91
 },
 {
  "line": 55,
  "text": "إعلان الفائز بالكرة الذهبية.",
  "start": 119.45,
  "end": 121.31
 },
 {
  "line": 56,
  "text": "ديفيد بيكهام كان جاي من موسم تاريخي،",
  "start": 121.91,
  "end": 124.22
 },
 {
  "line": 57,
  "text": "حقق فيه الثلاثية مع مانشستر يونايتد.",
  "start": 124.65,
  "end": 126.99
 },
 {
  "line": 58,
  "text": "لكن النتيجة كانت…",
  "start": 127.48,
  "end": 128.72
 },
 {
  "line": 59,
  "text": "بيكهام: 154 نقطة.",
  "start": 129.2,
  "end": 131.75
 },
 {
  "line": 60,
  "text": "ريفالدو: 219.",
  "start": 132.25,
  "end": 134.58
 },
 {
  "line": 61,
  "text": "ريفالدو يفوز بالكرة الذهبية.",
  "start": 134.73,
  "end": 137.24
 },
 {
  "line": 62,
  "text": "وكمان يفوز بجائزة الفيفا لأفضل لاعب في العالم لسنة 1999.",
  "start": 137.73,
  "end": 143.39
 },
 {
  "line": 63,
  "text": "الطفل اللي كان بيعاني عشان يوصل التمرين…",
  "start": 143.97,
  "end": 146.5
 },
 {
  "line": 64,
  "text": "بقى أفضل لاعب في العالم.",
  "start": 146.91,
  "end": 148.56
 },
 {
  "line": 65,
  "text": "المفروض دي تبقى أسعد فترة في حياته…",
  "start": 149.22,
  "end": 151.41
 },
 {
  "line": 66,
  "text": "صح؟",
  "start": 151.69,
  "end": 152.0
 },
 {
  "line": 67,
  "text": "لأ.",
  "start": 152.56,
  "end": 152.88
 },
 {
  "line": 68,
  "text": "لأن مع الكرة الذهبية…",
  "start": 153.39,
  "end": 154.72
 },
 {
  "line": 69,
  "text": "بدأت واحدة من أغرب أزمات ريفالدو مع برشلونة.",
  "start": 155.06,
  "end": 158.13
 },
 {
  "line": 70,
  "text": "لويس فان خال كان عايزه يلعب على الجناح الشمال.",
  "start": 158.72,
  "end": 161.21
 },
 {
  "line": 71,
  "text": "وريفالدو كان شايف إن أفضل مكان ليه هو العمق…",
  "start": 161.74,
  "end": 164.78
 },
 {
  "line": 72,
  "text": "خلف المهاجمين.",
  "start": 164.89,
  "end": 166.04
 },
 {
  "line": 73,
  "text": "الخلاف كبر…",
  "start": 166.61,
  "end": 167.43
 },
 {
  "line": 74,
  "text": "وريفالدو أعلن إنه مش عايز يكمل في مركز الجناح.",
  "start": 167.89,
  "end": 170.98
 },
 {
  "line": 75,
  "text": "فان خال رد بطريقته.",
  "start": 171.49,
  "end": 172.76
 },
 {
  "line": 76,
  "text": "استبعد أفضل لاعب في العالم من الفريق.",
  "start": 173.3,
  "end": 175.92
 },
 {
  "line": 77,
  "text": "الكرة الذهبية في إيده…",
  "start": 176.63,
  "end": 177.89
 },
 {
  "line": 78,
  "text": "ومكانه مش مضمون في التشكيل.",
  "start": 178.28,
  "end": 180.09
 },
 {
  "line": 79,
  "text": "لكن لو عايز تعرف ريفالدو كان لاعب عامل إزاي…",
  "start": 180.61,
  "end": 183.17
 },
 {
  "line": 80,
  "text": "فأنت محتاج تشوف ليلة واحدة بس.",
  "start": 183.65,
  "end": 185.78
 },
 {
  "line": 81,
  "text": "17 يونيو 2001.",
  "start": 186.34,
  "end": 188.33
 },
 {
  "line": 82,
  "text": "آخر جولة في الدوري الإسباني.",
  "start": 188.76,
  "end": 190.42
 },
 {
  "line": 83,
  "text": "برشلونة ضد فالنسيا…",
  "start": 190.9,
  "end": 192.62
 },
 {
  "line": 84,
  "text": "في الكامب نو.",
  "start": 192.91,
  "end": 193.58
 },
 {
  "line": 85,
  "text": "والحسبة بسيطة جدًا:",
  "start": 194.13,
  "end": 195.25
 },
 {
  "line": 86,
  "text": "برشلونة لازم يكسب…",
  "start": 195.77,
  "end": 197.12
 },
 {
  "line": 87,
  "text": "عشان يتأهل لدوري أبطال أوروبا.",
  "start": 197.21,
  "end": 199.01
 },
 {
  "line": 88,
  "text": "وريفالدو قرر يعمل واحدة من أعظم مبارياته بقميص برشلونة.",
  "start": 199.5,
  "end": 203.6,
  "checked": "manual"
 },
 {
  "line": 89,
  "text": "الجول الأول…",
  "start": 203.88,
  "end": 204.89,
  "checked": "manual"
 },
 {
  "line": 90,
  "text": "ضربة حرة مباشرة.",
  "start": 205.08,
  "end": 206.3,
  "checked": "manual"
 },
 {
  "line": 91,
  "text": "1-0.",
  "start": 206.66,
  "end": 207.34,
  "checked": "manual"
 },
 {
  "line": 92,
  "text": "فالنسيا يتعادل.",
  "start": 207.61,
  "end": 208.6,
  "checked": "manual"
 },
 {
  "line": 93,
  "text": "ريفالدو ياخد الكرة من بعيد…",
  "start": 209.11,
  "end": 210.77,
  "checked": "manual"
 },
 {
  "line": 94,
  "text": "ويسدد.",
  "start": 210.97,
  "end": 211.64,
  "checked": "manual"
 },
 {
  "line": 95,
  "text": "جول تاني.",
  "start": 211.93,
  "end": 212.63,
  "checked": "manual"
 },
 {
  "line": 96,
  "text": "2-1.",
  "start": 212.9,
  "end": 213.65,
  "checked": "manual"
 },
 {
  "line": 97,
  "text": "فالنسيا يتعادل من جديد.",
  "start": 213.99,
  "end": 215.43,
  "checked": "manual"
 },
 {
  "line": 98,
  "text": "2-2.",
  "start": 215.95,
  "end": 216.84,
  "checked": "manual"
 },
 {
  "line": 99,
  "text": "والوقت بيخلص.",
  "start": 217.07,
  "end": 218.14,
  "checked": "manual"
 },
 {
  "line": 100,
  "text": "بالنتيجة دي…",
  "start": 218.51,
  "end": 219.22
 },
 {
  "line": 101,
  "text": "برشلونة خارج دوري الأبطال.",
  "start": 219.54,
  "end": 221.46
 },
 {
  "line": 102,
  "text": "الدقيقة 87.",
  "start": 221.88,
  "end": 223.06
 },
 {
  "line": 103,
  "text": "فرانك دي بور يرسل كرة ناحية منطقة الجزاء.",
  "start": 223.32,
  "end": 225.75,
  "checked": "manual"
 },
 {
  "line": 104,
  "text": "ريفالدو يستقبلها بصدره…",
  "start": 226.09,
  "end": 227.46,
  "checked": "manual"
 },
 {
  "line": 105,
  "text": "والكرة لسه في الهوا…",
  "start": 227.62,
  "end": 228.79,
  "checked": "manual"
 },
 {
  "line": 106,
  "text": "يرمي جسمه للخلف…",
  "start": 229.01,
  "end": 230.25,
  "checked": "manual"
 },
 {
  "line": 107,
  "text": "مقصية.",
  "start": 230.45,
  "end": 231.17,
  "checked": "manual"
 },
 {
  "line": 108,
  "text": "جــــــــول.",
  "start": 231.37,
  "end": 232.31,
  "checked": "manual"
 },
 {
  "line": 109,
  "text": "3-2.",
  "start": 232.57,
  "end": 233.43,
  "checked": "manual"
 },
 {
  "line": 110,
  "text": "هاتريك لريـفالدو.",
  "start": 233.65,
  "end": 234.66,
  "checked": "manual"
 },
 {
  "line": 111,
  "text": "وبرشلونة إلى دوري أبطال أوروبا.",
  "start": 234.86,
  "end": 237.21,
  "checked": "manual"
 },
 {
  "line": 112,
  "text": "الكامب نو انفجر.",
  "start": 237.56,
  "end": 239.09
 },
 {
  "line": 113,
  "text": "وفي لحظة واحدة…",
  "start": 239.37,
  "end": 240.32
 },
 {
  "line": 114,
  "text": "ريفالدو أنقذ موسم برشلونة…",
  "start": 240.63,
  "end": 242.65
 },
 {
  "line": 115,
  "text": "بواحد من أشهر الأهداف في تاريخ النادي.",
  "start": 242.97,
  "end": 245.59
 },
 {
  "line": 116,
  "text": "لكن حكايته لسه كان ناقصها آخر مشهد.",
  "start": 246.12,
  "end": 249.44
 },
 {
  "line": 117,
  "text": "صيف 2002.",
  "start": 250.01,
  "end": 251.15
 },
 {
  "line": 118,
  "text": "ريفالدو واقف مع منتخب البرازيل في نهائي كأس العالم.",
  "start": 251.46,
  "end": 254.53
 },
 {
  "line": 119,
  "text": "البرازيل ضد ألمانيا.",
  "start": 254.97,
  "end": 256.52
 },
 {
  "line": 120,
  "text": "والبرازيل تكسب 2-0…",
  "start": 256.93,
  "end": 258.51
 },
 {
  "line": 121,
  "text": "وريفالدو يبقى بطل عالم.",
  "start": 258.82,
  "end": 260.65
 },
 {
  "line": 122,
  "text": "بس لما رجع من كأس العالم…",
  "start": 261.22,
  "end": 262.81
 },
 {
  "line": 123,
  "text": "لقى فان خال راجع يدرب برشلونة من تاني.",
  "start": 263.2,
  "end": 265.67
 },
 {
  "line": 124,
  "text": "وريفالدو قرر يرحل.",
  "start": 266.14,
  "end": 267.81
 },
 {
  "line": 125,
  "text": "من طفل عاش الفقر وسوء التغذية…",
  "start": 268.48,
  "end": 270.78
 },
 {
  "line": 126,
  "text": "وفقد أبوه وهو لسه بيحاول يبدأ مشواره…",
  "start": 271.14,
  "end": 273.86
 },
 {
  "line": 127,
  "text": "إلى لاعب حمل الكرة الذهبية…",
  "start": 274.29,
  "end": 276.31
 },
 {
  "line": 128,
  "text": "وسجل هدفًا مستحيلًا أنقذ به برشلونة في واحدة من أهم لياليه…",
  "start": 276.66,
  "end": 282.04
 },
 {
  "line": 129,
  "text": "وبعدها رفع كأس العالم بالرقم 10 مع البرازيل.",
  "start": 282.49,
  "end": 286.64
 },
 {
  "line": 130,
  "text": "دي كانت حكاية…",
  "start": 287.33,
  "end": 288.77
 },
 {
  "line": 131,
  "text": "ريفالدو.",
  "start": 288.95,
  "end": 289.67
 },
 {
  "line": 132,
  "text": "واحد من أعظم البرازيليين اللي لبسوا قميص برشلونة.",
  "start": 290.12,
  "end": 293.75
 },
 {
  "line": 133,
  "text": "وفي الحلقة الجاية…",
  "start": 294.31,
  "end": 295.16
 },
 {
  "line": 134,
  "text": "هنتكلم عن برازيلي تاني وصل برشلونة بعد ما ريفالدو مشي بسنة.",
  "start": 295.48,
  "end": 299.35
 },
 {
  "line": 135,
  "text": "لكن المرة دي…",
  "start": 299.77,
  "end": 300.63
 },
 {
  "line": 136,
  "text": "الابتسامة كانت جزء من اللعبة.",
  "start": 301.0,
  "end": 303.28
 },
