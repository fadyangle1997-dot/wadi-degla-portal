[
 {
  "start": 0.0,
  "end": 3.273,
  "lines": [
   "في نفس اليوم اللي اتعلن فيه",
   "أفضل لاعب في أوروبا…"
  ]
 },
 {
  "start": 3.34,
  "end": 5.69,
  "lines": [
   "علاقته بمدرب برشلونة انهارت."
  ]
 },
 {
  "start": 5.78,
  "end": 9.59,
  "lines": [
   "وأفضل لاعب في العالم وقتها…",
   "لقى نفسه على الدكة."
  ]
 },
 {
  "start": 10.18,
  "end": 13.74,
  "lines": [
   "لكن صدقني…",
   "دي مكانتش أصعب حاجة حصلتله."
  ]
 },
 {
  "start": 13.82,
  "end": 16.863,
  "lines": [
   "لأن قبل برشلونة…",
   "وقبل الكرة الذهبية…"
  ]
 },
 {
  "start": 16.93,
  "end": 20.04,
  "lines": [
   "الولد ده عاش طفولة",
   "من أفقر ما تتخيل."
  ]
 },
 {
  "start": 20.24,
  "end": 25.34,
  "lines": [
   "جسمه كان ضعيف بسبب سوء التغذية،",
   "وخسر عدد من أسنانه وهو لسه صغير."
  ]
 },
 {
  "start": 25.47,
  "end": 28.49,
  "lines": [
   "وكان بيمشي مسافات طويلة",
   "عشان يوصل للتمرين…"
  ]
 },
 {
  "start": 28.63,
  "end": 31.91,
  "lines": [
   "لأن ببساطة،",
   "مكانش معاه فلوس للمواصلات."
  ]
 },
 {
  "start": 32.13,
  "end": 35.9,
  "lines": [
   "الولد ده كان اسمه…",
   "ريفالدو فيتور بوربا فيريرا."
  ]
 },
 {
  "start": 36.05,
  "end": 39.383,
  "lines": [
   "اتولد سنة 1972 في ريسيفي،"
  ]
 },
 {
  "start": 39.45,
  "end": 43.04,
  "lines": [
   "شمال شرق البرازيل،",
   "وسط عيلة فقيرة جدًا."
  ]
 },
 {
  "start": 43.27,
  "end": 47.26,
  "lines": [
   "بس كان فيه شخص واحد مؤمن",
   "إن ابنه ممكن يبقى لاعب كبير…"
  ]
 },
 {
  "start": 47.38,
  "end": 49.02,
  "lines": [
   "أبوه، روميلدو."
  ]
 },
 {
  "start": 49.16,
  "end": 51.153,
  "lines": [
   "كان بيشجعه،",
   "وبيتابعه،"
  ]
 },
 {
  "start": 51.22,
  "end": 52.52,
  "lines": [
   "وبيحلم معاه."
  ]
 },
 {
  "start": 52.67,
  "end": 56.54,
  "lines": [
   "لكن سنة 1989…",
   "حصلت الصدمة."
  ]
 },
 {
  "start": 57.34,
  "end": 59.4,
  "lines": [
   "والد ريفالدو مات في حادث."
  ]
 },
 {
  "start": 59.5,
  "end": 61.93,
  "lines": [
   "وريفالدو وقتها قرر يسيب الكورة."
  ]
 },
 {
  "start": 62.12,
  "end": 63.91,
  "lines": [
   "الحلم بالنسباله انتهى."
  ]
 },
 {
  "start": 64.06,
  "end": 65.463,
  "lines": [
   "لكن أمه رفضت."
  ]
 },
 {
  "start": 65.53,
  "end": 66.69,
  "lines": [
   "قالتله يكمل…"
  ]
 },
 {
  "start": 66.84,
  "end": 69.36,
  "lines": [
   "لأن ده كان الحلم",
   "اللي أبوه مؤمن بيه."
  ]
 },
 {
  "start": 69.52,
  "end": 70.73,
  "lines": [
   "وريفالدو كمل."
  ]
 },
 {
  "start": 70.89,
  "end": 72.263,
  "lines": [
   "بدأ مع سانتا كروز،"
  ]
 },
 {
  "start": 72.33,
  "end": 75.003,
  "lines": [
   "وبعدها موجي ميريم،",
   "ثم كورينثيانز،"
  ]
 },
 {
  "start": 75.07,
  "end": 78.8,
  "lines": [
   "وبالميراس…",
   "لحد ما أوروبا بدأت تاخد بالها منه."
  ]
 },
 {
  "start": 79.0,
  "end": 81.233,
  "lines": [
   "سنة 1996…"
  ]
 },
 {
  "start": 81.3,
  "end": 84.74,
  "lines": [
   "ريفالدو وصل إسبانيا",
   "من بوابة ديبورتيفو لاكورونيا."
  ]
 },
 {
  "start": 84.89,
  "end": 86.413,
  "lines": [
   "وموسم واحد بس…"
  ]
 },
 {
  "start": 86.48,
  "end": 89.25,
  "lines": [
   "كان كفاية عشان برشلونة",
   "يقرر إنه عايزه."
  ]
 },
 {
  "start": 89.44,
  "end": 91.663,
  "lines": [
   "صيف 1997…"
  ]
 },
 {
  "start": 91.73,
  "end": 94.153,
  "lines": [
   "برشلونة كان لسه خسر",
   "رونالدو نازاريو،"
  ]
 },
 {
  "start": 94.22,
  "end": 95.93,
  "lines": [
   "اللي انتقل لإنتر ميلان."
  ]
 },
 {
  "start": 96.1,
  "end": 98.773,
  "lines": [
   "والنادي كان محتاج",
   "نجم برازيلي جديد."
  ]
 },
 {
  "start": 98.84,
  "end": 101.2,
  "lines": [
   "والاختيار وقع على ريفالدو."
  ]
 },
 {
  "start": 101.39,
  "end": 104.74,
  "lines": [
   "ومن هنا…",
   "بدأت أهم مرحلة في حكايته."
  ]
 },
 {
  "start": 109.94,
  "end": 114.193,
  "lines": [
   "في أول موسمين مع برشلونة…",
   "ريفالدو كسب الدوري الإسباني مرتين،"
  ]
 },
 {
  "start": 114.26,
  "end": 115.77,
  "lines": [
   "وكأس الملك مرة."
  ]
 },
 {
  "start": 115.91,
  "end": 121.6,
  "lines": [
   "لكن اللي حصل سنة 1999…",
   "حطه رسميًا على قمة العالم."
  ]
 },
 {
  "start": 121.83,
  "end": 125.31,
  "lines": [
   "21 ديسمبر 1999."
  ]
 },
 {
  "start": 125.45,
  "end": 127.71,
  "lines": [
   "إعلان الفائز بالكرة الذهبية."
  ]
 },
 {
  "start": 127.91,
  "end": 130.583,
  "lines": [
   "ديفيد بيكهام كان",
   "جاي من موسم تاريخي،"
  ]
 },
 {
  "start": 130.65,
  "end": 133.39,
  "lines": [
   "حقق فيه الثلاثية",
   "مع مانشستر يونايتد."
  ]
 },
 {
  "start": 133.48,
  "end": 135.12,
  "lines": [
   "لكن النتيجة كانت…"
  ]
 },
 {
  "start": 136.0,
  "end": 138.95,
  "lines": [
   "بيكهام: 154 نقطة."
  ]
 },
 {
  "start": 139.05,
  "end": 141.463,
  "lines": [
   "ريفالدو: 219."
  ]
 },
 {
  "start": 141.53,
  "end": 144.44,
  "lines": [
   "ريفالدو يفوز بالكرة الذهبية."
  ]
 },
 {
  "start": 144.53,
  "end": 150.59,
  "lines": [
   "وكمان يفوز بجائزة الفيفا",
   "لأفضل لاعب في العالم لسنة 1999."
  ]
 },
 {
  "start": 150.77,
  "end": 153.643,
  "lines": [
   "الطفل اللي كان بيعاني",
   "عشان يوصل التمرين…"
  ]
 },
 {
  "start": 153.71,
  "end": 155.76,
  "lines": [
   "بقى أفضل لاعب في العالم."
  ]
 },
 {
  "start": 156.02,
  "end": 158.423,
  "lines": [
   "المفروض دي تبقى",
   "أسعد فترة في حياته…"
  ]
 },
 {
  "start": 158.49,
  "end": 159.2,
  "lines": [
   "صح؟"
  ]
 },
 {
  "start": 160.16,
  "end": 160.88,
  "lines": [
   "لأ."
  ]
 },
 {
  "start": 161.49,
  "end": 163.093,
  "lines": [
   "لأن مع الكرة الذهبية…"
  ]
 },
 {
  "start": 163.16,
  "end": 166.63,
  "lines": [
   "بدأت واحدة من أغرب أزمات",
   "ريفالدو مع برشلونة."
  ]
 },
 {
  "start": 166.82,
  "end": 169.71,
  "lines": [
   "لويس فان خال كان عايزه",
   "يلعب على الجناح الشمال."
  ]
 },
 {
  "start": 169.84,
  "end": 172.923,
  "lines": [
   "وريفالدو كان شايف إن",
   "أفضل مكان ليه هو العمق…"
  ]
 },
 {
  "start": 172.99,
  "end": 174.54,
  "lines": [
   "خلف المهاجمين."
  ]
 },
 {
  "start": 174.71,
  "end": 175.923,
  "lines": [
   "الخلاف كبر…"
  ]
 },
 {
  "start": 175.99,
  "end": 179.48,
  "lines": [
   "وريفالدو أعلن إنه مش عايز",
   "يكمل في مركز الجناح."
  ]
 },
 {
  "start": 179.59,
  "end": 181.26,
  "lines": [
   "فان خال رد بطريقته."
  ]
 },
 {
  "start": 181.4,
  "end": 184.42,
  "lines": [
   "استبعد أفضل لاعب في العالم",
   "من الفريق."
  ]
 },
 {
  "start": 184.73,
  "end": 188.59,
  "lines": [
   "الكرة الذهبية في إيده…",
   "ومكانه مش مضمون في التشكيل."
  ]
 },
 {
  "start": 188.71,
  "end": 191.67,
  "lines": [
   "لكن لو عايز تعرف ريفالدو",
   "كان لاعب عامل إزاي…"
  ]
 },
 {
  "start": 194.75,
  "end": 197.28,
  "lines": [
   "فأنت محتاج تشوف ليلة واحدة بس."
  ]
 },
 {
  "start": 197.44,
  "end": 199.793,
  "lines": [
   "17 يونيو 2001."
  ]
 },
 {
  "start": 199.86,
  "end": 201.92,
  "lines": [
   "آخر جولة في الدوري الإسباني."
  ]
 },
 {
  "start": 202.0,
  "end": 205.08,
  "lines": [
   "برشلونة ضد فالنسيا…",
   "في الكامب نو."
  ]
 },
 {
  "start": 205.23,
  "end": 208.243,
  "lines": [
   "والحسبة بسيطة جدًا:",
   "برشلونة لازم يكسب…"
  ]
 },
 {
  "start": 208.31,
  "end": 210.51,
  "lines": [
   "عشان يتأهل لدوري أبطال أوروبا."
  ]
 },
 {
  "start": 210.6,
  "end": 214.913,
  "lines": [
   "وريفالدو قرر يعمل واحدة",
   "من أعظم مبارياته بقميص برشلونة."
  ]
 },
 {
  "start": 214.98,
  "end": 216.113,
  "lines": [
   "الجول الأول…"
  ]
 },
 {
  "start": 216.18,
  "end": 217.693,
  "lines": [
   "ضربة حرة مباشرة."
  ]
 },
 {
  "start": 217.76,
  "end": 218.643,
  "lines": [
   "1-0."
  ]
 },
 {
  "start": 218.71,
  "end": 220.1,
  "lines": [
   "فالنسيا يتعادل."
  ]
 },
 {
  "start": 220.21,
  "end": 222.003,
  "lines": [
   "ريفالدو ياخد الكرة من بعيد…"
  ]
 },
 {
  "start": 222.07,
  "end": 222.963,
  "lines": [
   "ويسدد."
  ]
 },
 {
  "start": 223.03,
  "end": 223.933,
  "lines": [
   "جول تاني."
  ]
 },
 {
  "start": 224.0,
  "end": 225.023,
  "lines": [
   "2-1."
  ]
 },
 {
  "start": 225.09,
  "end": 226.93,
  "lines": [
   "فالنسيا يتعادل من جديد."
  ]
 },
 {
  "start": 227.05,
  "end": 228.103,
  "lines": [
   "2-2."
  ]
 },
 {
  "start": 228.17,
  "end": 229.543,
  "lines": [
   "والوقت بيخلص."
  ]
 },
 {
  "start": 229.61,
  "end": 230.573,
  "lines": [
   "بالنتيجة دي…"
  ]
 },
 {
  "start": 230.64,
  "end": 232.913,
  "lines": [
   "برشلونة خارج دوري الأبطال."
  ]
 },
 {
  "start": 232.98,
  "end": 234.353,
  "lines": [
   "الدقيقة 87."
  ]
 },
 {
  "start": 234.42,
  "end": 237.123,
  "lines": [
   "فرانك دي بور يرسل كرة",
   "ناحية منطقة الجزاء."
  ]
 },
 {
  "start": 237.19,
  "end": 238.653,
  "lines": [
   "ريفالدو يستقبلها بصدره…"
  ]
 },
 {
  "start": 238.72,
  "end": 240.043,
  "lines": [
   "والكرة لسه في الهوا…"
  ]
 },
 {
  "start": 240.11,
  "end": 241.75,
  "lines": [
   "يرمي جسمه للخلف…"
  ]
 },
 {
  "start": 242.45,
  "end": 243.303,
  "lines": [
   "مقصية."
  ]
 },
 {
  "start": 243.37,
  "end": 244.71,
  "lines": [
   "جول."
  ]
 },
 {
  "start": 246.07,
  "end": 247.083,
  "lines": [
   "3-2."
  ]
 },
 {
  "start": 247.15,
  "end": 248.293,
  "lines": [
   "هاتريك لريفالدو."
  ]
 },
 {
  "start": 248.36,
  "end": 250.993,
  "lines": [
   "وبرشلونة إلى دوري أبطال أوروبا."
  ]
 },
 {
  "start": 251.06,
  "end": 252.803,
  "lines": [
   "الكامب نو انفجر."
  ]
 },
 {
  "start": 252.87,
  "end": 256.403,
  "lines": [
   "وفي لحظة واحدة…",
   "ريفالدو أنقذ موسم برشلونة…"
  ]
 },
 {
  "start": 256.47,
  "end": 259.49,
  "lines": [
   "بواحد من أشهر الأهداف",
   "في تاريخ النادي."
  ]
 },
 {
  "start": 259.62,
  "end": 263.34,
  "lines": [
   "لكن حكايته لسه كان",
   "ناقصها آخر مشهد."
  ]
 },
 {
  "start": 263.51,
  "end": 264.893,
  "lines": [
   "صيف 2002."
  ]
 },
 {
  "start": 264.96,
  "end": 268.403,
  "lines": [
   "ريفالدو واقف مع منتخب البرازيل",
   "في نهائي كأس العالم."
  ]
 },
 {
  "start": 268.47,
  "end": 270.363,
  "lines": [
   "البرازيل ضد ألمانيا."
  ]
 },
 {
  "start": 270.43,
  "end": 274.55,
  "lines": [
   "والبرازيل تكسب 2-0…",
   "وريفالدو يبقى بطل عالم."
  ]
 },
 {
  "start": 274.72,
  "end": 276.633,
  "lines": [
   "بس لما رجع من كأس العالم…"
  ]
 },
 {
  "start": 276.7,
  "end": 279.57,
  "lines": [
   "لقى فان خال راجع",
   "يدرب برشلونة من تاني."
  ]
 },
 {
  "start": 279.64,
  "end": 281.71,
  "lines": [
   "وريفالدو قرر يرحل."
  ]
 },
 {
  "start": 281.98,
  "end": 284.573,
  "lines": [
   "من طفل عاش الفقر وسوء التغذية…"
  ]
 },
 {
  "start": 284.64,
  "end": 287.723,
  "lines": [
   "وفقد أبوه وهو لسه",
   "بيحاول يبدأ مشواره…"
  ]
 },
 {
  "start": 287.79,
  "end": 290.093,
  "lines": [
   "إلى لاعب حمل الكرة الذهبية…"
  ]
 },
 {
  "start": 290.16,
  "end": 295.923,
  "lines": [
   "وسجل هدفًا مستحيلًا أنقذ به",
   "برشلونة في واحدة من أهم لياليه…"
  ]
 },
 {
  "start": 295.99,
  "end": 300.54,
  "lines": [
   "وبعدها رفع كأس العالم",
   "بالرقم 10 مع البرازيل."
  ]
 },
 {
  "start": 300.83,
  "end": 302.67,
  "lines": [
   "دي كانت حكاية…"
  ]
 },
 {
  "start": 303.15,
  "end": 304.253,
  "lines": [
   "ريفالدو."
  ]
 },
 {
  "start": 304.32,
  "end": 308.35,
  "lines": [
   "واحد من أعظم البرازيليين",
   "اللي لبسوا قميص برشلونة."
  ]
 },
 {
  "start": 308.51,
  "end": 309.613,
  "lines": [
   "وفي الحلقة الجاية…"
  ]
 },
 {
  "start": 309.68,
  "end": 313.903,
  "lines": [
   "هنتكلم عن برازيلي تاني وصل برشلونة",
   "بعد ما ريفالدو مشي بسنة."
  ]
 },
 {
  "start": 313.97,
  "end": 317.88,
  "lines": [
   "لكن المرة دي…",
   "الابتسامة كانت جزء من اللعبة."
  ]
 },
 {
  "start": 318.0,
  "end": 319.37,
  "lines": [
   "رونالدينيو."
  ]
 }
]