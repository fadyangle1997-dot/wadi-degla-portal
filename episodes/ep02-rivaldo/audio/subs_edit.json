[
 {
  "start": 0.0,
  "end": 3.273,
  "lines": [
   "في نفس اليوم اللي اتعلن فيه",
   "أفضل لاعب في أوروبا…"
  ]
 },
 {
  "start": 3.34,
  "end": 5.69,
  "lines": [
   "علاقته بمدرب برشلونة انهارت."
  ]
 },
 {
  "start": 5.78,
  "end": 9.59,
  "lines": [
   "وأفضل لاعب في العالم وقتها…",
   "لقى نفسه على الدكة."
  ]
 },
 {
  "start": 10.18,
  "end": 13.74,
  "lines": [
   "لكن صدقني…",
   "دي مكانتش أصعب حاجة حصلتله."
  ]
 },
 {
  "start": 13.82,
  "end": 16.863,
  "lines": [
   "لأن قبل برشلونة…",
   "وقبل الكرة الذهبية…"
  ]
 },
 {
  "start": 16.93,
  "end": 20.04,
  "lines": [
   "الولد ده عاش طفولة من أفقر ما تتخيل."
  ]
 },
 {
  "start": 20.24,
  "end": 25.34,
  "lines": [
   "جسمه كان ضعيف بسبب سوء التغذية،",
   "وخسر عدد من أسنانه وهو لسه صغير."
  ]
 },
 {
  "start": 25.47,
  "end": 28.49,
  "lines": [
   "وكان بيمشي مسافات طويلة عشان يوصل للتمرين…"
  ]
 },
 {
  "start": 28.63,
  "end": 31.91,
  "lines": [
   "لأن ببساطة،",
   "مكانش معاه فلوس للمواصلات."
  ]
 },
 {
  "start": 32.13,
  "end": 35.9,
  "lines": [
   "الولد ده كان اسمه…",
   "ريفالدو فيتور بوربا فيريرا."
  ]
 },
 {
  "start": 36.05,
  "end": 39.383,
  "lines": [
   "اتولد سنة 1972 في ريسيفي،"
  ]
 },
 {
  "start": 39.45,
  "end": 43.04,
  "lines": [
   "شمال شرق البرازيل،",
   "وسط عيلة فقيرة جدًا."
  ]
 },
 {
  "start": 43.27,
  "end": 47.26,
  "lines": [
   "بس كان فيه شخص واحد مؤمن",
   "إن ابنه ممكن يبقى لاعب كبير…"
  ]
 },
 {
  "start": 47.38,
  "end": 49.02,
  "lines": [
   "أبوه، روميلدو."
  ]
 },
 {
  "start": 49.16,
  "end": 51.153,
  "lines": [
   "كان بيشجعه،",
   "وبيتابعه،"
  ]
 },
 {
  "start": 51.22,
  "end": 52.52,
  "lines": [
   "وبيحلم معاه."
  ]
 },
 {
  "start": 52.67,
  "end": 56.54,
  "lines": [
   "لكن سنة 1989…",
   "حصلت الصدمة."
  ]
 },
 {
  "start": 57.34,
  "end": 59.4,
  "lines": [
   "والد ريفالدو مات في حادث."
  ]
 },
 {
  "start": 59.5,
  "end": 61.93,
  "lines": [
   "وريفالدو وقتها قرر يسيب الكورة."
  ]
 },
 {
  "start": 62.12,
  "end": 63.91,
  "lines": [
   "الحلم بالنسباله انتهى."
  ]
 },
 {
  "start": 64.06,
  "end": 65.463,
  "lines": [
   "لكن أمه رفضت."
  ]
 },
 {
  "start": 65.53,
  "end": 69.36,
  "lines": [
   "قالتله يكمل…",
   "لأن ده كان الحلم اللي أبوه مؤمن بيه."
  ]
 },
 {
  "start": 69.52,
  "end": 70.73,
  "lines": [
   "وريفالدو كمل."
  ]
 },
 {
  "start": 70.89,
  "end": 72.263,
  "lines": [
   "بدأ مع سانتا كروز،"
  ]
 },
 {
  "start": 72.33,
  "end": 75.003,
  "lines": [
   "وبعدها موجي ميريم،",
   "ثم كورينثيانز،"
  ]
 },
 {
  "start": 75.07,
  "end": 78.8,
  "lines": [
   "وبالميراس…",
   "لحد ما أوروبا بدأت تاخد بالها منه."
  ]
 },
 {
  "start": 79.0,
  "end": 81.233,
  "lines": [
   "سنة 1996…"
  ]
 },
 {
  "start": 81.3,
  "end": 84.74,
  "lines": [
   "ريفالدو وصل إسبانيا",
   "من بوابة ديبورتيفو لاكورونيا."
  ]
 },
 {
  "start": 84.89,
  "end": 89.25,
  "lines": [
   "وموسم واحد بس…",
   "كان كفاية عشان برشلونة يقرر إنه عايزه."
  ]
 },
 {
  "start": 89.44,
  "end": 94.153,
  "lines": [
   "صيف 1997…",
   "برشلونة كان لسه خسر رونالدو نازاريو،"
  ]
 },
 {
  "start": 94.22,
  "end": 95.93,
  "lines": [
   "اللي انتقل لإنتر ميلان."
  ]
 },
 {
  "start": 96.1,
  "end": 98.773,
  "lines": [
   "والنادي كان محتاج نجم برازيلي جديد."
  ]
 },
 {
  "start": 98.84,
  "end": 101.2,
  "lines": [
   "والاختيار وقع على ريفالدو."
  ]
 },
 {
  "start": 101.39,
  "end": 104.74,
  "lines": [
   "ومن هنا…",
   "بدأت أهم مرحلة في حكايته."
  ]
 },
 {
  "start": 104.94,
  "end": 109.193,
  "lines": [
   "في أول موسمين مع برشلونة…",
   "ريفالدو كسب الدوري الإسباني مرتين،"
  ]
 },
 {
  "start": 109.26,
  "end": 110.77,
  "lines": [
   "وكأس الملك مرة."
  ]
 },
 {
  "start": 110.91,
  "end": 116.6,
  "lines": [
   "لكن اللي حصل سنة 1999…",
   "حطه رسميًا على قمة العالم."
  ]
 },
 {
  "start": 116.83,
  "end": 120.31,
  "lines": [
   "21 ديسمبر 1999."
  ]
 },
 {
  "start": 120.45,
  "end": 122.71,
  "lines": [
   "إعلان الفائز بالكرة الذهبية."
  ]
 },
 {
  "start": 122.91,
  "end": 128.39,
  "lines": [
   "ديفيد بيكهام كان جاي من موسم تاريخي،",
   "حقق فيه الثلاثية مع مانشستر يونايتد."
  ]
 },
 {
  "start": 128.48,
  "end": 130.12,
  "lines": [
   "لكن النتيجة كانت…"
  ]
 },
 {
  "start": 131.0,
  "end": 133.95,
  "lines": [
   "بيكهام: 154 نقطة."
  ]
 },
 {
  "start": 134.05,
  "end": 136.463,
  "lines": [
   "ريفالدو: 219."
  ]
 },
 {
  "start": 136.53,
  "end": 139.44,
  "lines": [
   "ريفالدو يفوز بالكرة الذهبية."
  ]
 },
 {
  "start": 139.53,
  "end": 145.59,
  "lines": [
   "وكمان يفوز بجائزة الفيفا لأفضل",
   "لاعب في العالم لسنة 1999."
  ]
 },
 {
  "start": 145.77,
  "end": 150.76,
  "lines": [
   "الطفل اللي كان بيعاني عشان يوصل التمرين…",
   "بقى أفضل لاعب في العالم."
  ]
 },
 {
  "start": 151.02,
  "end": 153.423,
  "lines": [
   "المفروض دي تبقى أسعد فترة في حياته…"
  ]
 },
 {
  "start": 153.49,
  "end": 154.2,
  "lines": [
   "صح؟"
  ]
 },
 {
  "start": 155.16,
  "end": 155.88,
  "lines": [
   "لأ."
  ]
 },
 {
  "start": 156.49,
  "end": 158.093,
  "lines": [
   "لأن مع الكرة الذهبية…"
  ]
 },
 {
  "start": 158.16,
  "end": 161.63,
  "lines": [
   "بدأت واحدة من أغرب أزمات",
   "ريفالدو مع برشلونة."
  ]
 },
 {
  "start": 161.82,
  "end": 164.71,
  "lines": [
   "لويس فان خال كان عايزه",
   "يلعب على الجناح الشمال."
  ]
 },
 {
  "start": 164.84,
  "end": 167.923,
  "lines": [
   "وريفالدو كان شايف إن",
   "أفضل مكان ليه هو العمق…"
  ]
 },
 {
  "start": 167.99,
  "end": 169.54,
  "lines": [
   "خلف المهاجمين."
  ]
 },
 {
  "start": 169.71,
  "end": 170.923,
  "lines": [
   "الخلاف كبر…"
  ]
 },
 {
  "start": 170.99,
  "end": 174.48,
  "lines": [
   "وريفالدو أعلن إنه مش عايز",
   "يكمل في مركز الجناح."
  ]
 },
 {
  "start": 174.59,
  "end": 176.26,
  "lines": [
   "فان خال رد بطريقته."
  ]
 },
 {
  "start": 176.4,
  "end": 179.42,
  "lines": [
   "استبعد أفضل لاعب في العالم من الفريق."
  ]
 },
 {
  "start": 179.73,
  "end": 183.59,
  "lines": [
   "الكرة الذهبية في إيده…",
   "ومكانه مش مضمون في التشكيل."
  ]
 },
 {
  "start": 183.71,
  "end": 186.67,
  "lines": [
   "لكن لو عايز تعرف ريفالدو",
   "كان لاعب عامل إزاي…"
  ]
 },
 {
  "start": 186.75,
  "end": 189.28,
  "lines": [
   "فأنت محتاج تشوف ليلة واحدة بس."
  ]
 },
 {
  "start": 189.44,
  "end": 191.793,
  "lines": [
   "17 يونيو 2001."
  ]
 },
 {
  "start": 191.86,
  "end": 193.92,
  "lines": [
   "آخر جولة في الدوري الإسباني."
  ]
 },
 {
  "start": 194.0,
  "end": 197.08,
  "lines": [
   "برشلونة ضد فالنسيا…",
   "في الكامب نو."
  ]
 },
 {
  "start": 197.23,
  "end": 200.243,
  "lines": [
   "والحسبة بسيطة جدًا:",
   "برشلونة لازم يكسب…"
  ]
 },
 {
  "start": 200.31,
  "end": 202.51,
  "lines": [
   "عشان يتأهل لدوري أبطال أوروبا."
  ]
 },
 {
  "start": 202.6,
  "end": 206.913,
  "lines": [
   "وريفالدو قرر يعمل واحدة",
   "من أعظم مبارياته بقميص برشلونة."
  ]
 },
 {
  "start": 206.98,
  "end": 208.113,
  "lines": [
   "الجول الأول…"
  ]
 },
 {
  "start": 208.18,
  "end": 209.693,
  "lines": [
   "ضربة حرة مباشرة."
  ]
 },
 {
  "start": 209.76,
  "end": 210.643,
  "lines": [
   "1-0."
  ]
 },
 {
  "start": 210.71,
  "end": 212.1,
  "lines": [
   "فالنسيا يتعادل."
  ]
 },
 {
  "start": 212.21,
  "end": 214.003,
  "lines": [
   "ريفالدو ياخد الكرة من بعيد…"
  ]
 },
 {
  "start": 214.07,
  "end": 214.963,
  "lines": [
   "ويسدد."
  ]
 },
 {
  "start": 215.03,
  "end": 215.933,
  "lines": [
   "جول تاني."
  ]
 },
 {
  "start": 216.0,
  "end": 217.023,
  "lines": [
   "2-1."
  ]
 },
 {
  "start": 217.09,
  "end": 218.93,
  "lines": [
   "فالنسيا يتعادل من جديد."
  ]
 },
 {
  "start": 219.05,
  "end": 220.103,
  "lines": [
   "2-2."
  ]
 },
 {
  "start": 220.17,
  "end": 221.543,
  "lines": [
   "والوقت بيخلص."
  ]
 },
 {
  "start": 221.61,
  "end": 222.573,
  "lines": [
   "بالنتيجة دي…"
  ]
 },
 {
  "start": 222.64,
  "end": 224.913,
  "lines": [
   "برشلونة خارج دوري الأبطال."
  ]
 },
 {
  "start": 224.98,
  "end": 226.353,
  "lines": [
   "الدقيقة 87."
  ]
 },
 {
  "start": 226.42,
  "end": 229.123,
  "lines": [
   "فرانك دي بور يرسل كرة ناحية منطقة الجزاء."
  ]
 },
 {
  "start": 229.19,
  "end": 230.653,
  "lines": [
   "ريفالدو يستقبلها بصدره…"
  ]
 },
 {
  "start": 230.72,
  "end": 232.043,
  "lines": [
   "والكرة لسه في الهوا…"
  ]
 },
 {
  "start": 232.11,
  "end": 233.75,
  "lines": [
   "يرمي جسمه للخلف…"
  ]
 },
 {
  "start": 234.45,
  "end": 235.303,
  "lines": [
   "مقصية."
  ]
 },
 {
  "start": 235.37,
  "end": 236.71,
  "lines": [
   "جول."
  ]
 },
 {
  "start": 238.07,
  "end": 239.083,
  "lines": [
   "3-2."
  ]
 },
 {
  "start": 239.15,
  "end": 240.293,
  "lines": [
   "هاتريك لريفالدو."
  ]
 },
 {
  "start": 240.36,
  "end": 242.993,
  "lines": [
   "وبرشلونة إلى دوري أبطال أوروبا."
  ]
 },
 {
  "start": 243.06,
  "end": 244.803,
  "lines": [
   "الكامب نو انفجر."
  ]
 },
 {
  "start": 244.87,
  "end": 248.403,
  "lines": [
   "وفي لحظة واحدة…",
   "ريفالدو أنقذ موسم برشلونة…"
  ]
 },
 {
  "start": 248.47,
  "end": 251.49,
  "lines": [
   "بواحد من أشهر الأهداف في تاريخ النادي."
  ]
 },
 {
  "start": 251.62,
  "end": 255.34,
  "lines": [
   "لكن حكايته لسه كان ناقصها آخر مشهد."
  ]
 },
 {
  "start": 255.51,
  "end": 256.893,
  "lines": [
   "صيف 2002."
  ]
 },
 {
  "start": 256.96,
  "end": 260.403,
  "lines": [
   "ريفالدو واقف مع منتخب البرازيل",
   "في نهائي كأس العالم."
  ]
 },
 {
  "start": 260.47,
  "end": 262.363,
  "lines": [
   "البرازيل ضد ألمانيا."
  ]
 },
 {
  "start": 262.43,
  "end": 266.55,
  "lines": [
   "والبرازيل تكسب 2-0…",
   "وريفالدو يبقى بطل عالم."
  ]
 },
 {
  "start": 266.72,
  "end": 271.57,
  "lines": [
   "بس لما رجع من كأس العالم…",
   "لقى فان خال راجع يدرب برشلونة من تاني."
  ]
 },
 {
  "start": 271.64,
  "end": 273.71,
  "lines": [
   "وريفالدو قرر يرحل."
  ]
 },
 {
  "start": 273.98,
  "end": 279.723,
  "lines": [
   "من طفل عاش الفقر وسوء التغذية…",
   "وفقد أبوه وهو لسه بيحاول يبدأ مشواره…"
  ]
 },
 {
  "start": 279.79,
  "end": 282.093,
  "lines": [
   "إلى لاعب حمل الكرة الذهبية…"
  ]
 },
 {
  "start": 282.16,
  "end": 287.923,
  "lines": [
   "وسجل هدفًا مستحيلًا أنقذ به برشلونة",
   "في واحدة من أهم لياليه…"
  ]
 },
 {
  "start": 287.99,
  "end": 292.54,
  "lines": [
   "وبعدها رفع كأس العالم",
   "بالرقم 10 مع البرازيل."
  ]
 },
 {
  "start": 292.83,
  "end": 294.67,
  "lines": [
   "دي كانت حكاية…"
  ]
 },
 {
  "start": 295.15,
  "end": 296.253,
  "lines": [
   "ريفالدو."
  ]
 },
 {
  "start": 296.32,
  "end": 300.35,
  "lines": [
   "واحد من أعظم البرازيليين",
   "اللي لبسوا قميص برشلونة."
  ]
 },
 {
  "start": 300.51,
  "end": 301.613,
  "lines": [
   "وفي الحلقة الجاية…"
  ]
 },
 {
  "start": 301.68,
  "end": 305.903,
  "lines": [
   "هنتكلم عن برازيلي تاني",
   "وصل برشلونة بعد ما ريفالدو مشي بسنة."
  ]
 },
 {
  "start": 305.97,
  "end": 309.88,
  "lines": [
   "لكن المرة دي…",
   "الابتسامة كانت جزء من اللعبة."
  ]
 },
 {
  "start": 310.0,
  "end": 311.37,
  "lines": [
   "رونالدينيو."
  ]
 }
]